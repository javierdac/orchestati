# Sin nada de esto, el orquestador usa el MockModel: el ruteo es real, las
# respuestas no. Sirve para desarrollar y testear todo sin gastar un peso.

# --- Elegí UNO ---------------------------------------------------------------

# OpenAI
# OPENAI_API_KEY=

# Gemini (tiene nivel gratuito; se usa via su endpoint compatible con OpenAI)
GEMINI_API_KEY=

# Groq (nivel gratuito, corre modelos de pesos abiertos: Llama, Kimi)
# GROQ_API_KEY=

# xAI / Grok  (ojo: Grok es el modelo de xAI, distinto de Groq el proveedor)
# XAI_API_KEY=

# Moonshot / Kimi
# MOONSHOT_API_KEY=

# DeepSeek
# DEEPSEEK_API_KEY=

# Cerebras (modelos abiertos, muy rápido)
# CEREBRAS_API_KEY=

# OpenRouter
# OPENROUTER_API_KEY=

# Vercel AI Gateway (una key para todos los proveedores)
# AI_GATEWAY_API_KEY=

# --- Opcional ----------------------------------------------------------------

# Forzar un backend base: openai | gemini | groq | moonshot | deepseek | cerebras |
#                        openrouter | gateway | ollama | lmstudio | mock
# Los locales (ollama, lmstudio) NO se autodetectan: hay que pedirlos acá.
# ORCHESTATI_PROVIDER=

# Modelo por escalón. Acepta "modelo" (usa el proveedor base) o
# "proveedor:modelo" para MEZCLAR proveedores entre escalones.
#
# Mezclar es lo que hace que el ruteo ahorre de verdad: entre escalones de un
# mismo proveedor la brecha de precio suele ser 5x, y como las estrategias
# chain y parallel corren 2-3 agentes, el escalón medio termina costando lo
# mismo que una sola llamada al caro. Entre proveedores la brecha es 10x-40x.
#
# ORCHESTATI_MODEL_LIGHT=groq:llama-3.1-8b-instant
# ORCHESTATI_MODEL_STANDARD=groq:llama-3.3-70b-versatile
# ORCHESTATI_MODEL_DEEP=openai:gpt-4.1
# ORCHESTATI_MODEL_SWARM=groq:llama-3.3-70b-versatile
#
# `pnpm models` lista los modelos que cada proveedor configurado ofrece.

# Endpoint propio compatible con OpenAI
# ORCHESTATI_BASE_URL=
