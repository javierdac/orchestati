# Sin nada de esto, el orquestador usa el MockModel: el ruteo es real, las
# respuestas no. Sirve para desarrollar y testear todo sin gastar un peso.

# --- Elegí UNO ---------------------------------------------------------------

# Gemini (tiene nivel gratuito; se usa via su endpoint compatible con OpenAI)
GEMINI_API_KEY=

# Groq (nivel gratuito, corre modelos de pesos abiertos)
# GROQ_API_KEY=

# OpenRouter
# OPENROUTER_API_KEY=

# Vercel AI Gateway (una key para todos los proveedores)
# AI_GATEWAY_API_KEY=

# --- Opcional ----------------------------------------------------------------

# Forzar un backend: gemini | groq | openrouter | gateway | ollama | lmstudio | mock
# Los locales (ollama, lmstudio) NO se autodetectan: hay que pedirlos acá.
# ORCHESTATI_PROVIDER=

# Pisar el modelo de cada escalón
# ORCHESTATI_MODEL_LIGHT=
# ORCHESTATI_MODEL_STANDARD=
# ORCHESTATI_MODEL_DEEP=
# ORCHESTATI_MODEL_SWARM=

# Endpoint propio compatible con OpenAI
# ORCHESTATI_BASE_URL=
