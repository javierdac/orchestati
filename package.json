{
  "name": "orchestati",
  "version": "0.1.0",
  "description": "Dynamic agent orchestrator: analyzes every request locally (zero tokens) and routes it to the right agent, tier and strategy.",
  "license": "MIT",
  "author": "Javier D'Accorso",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javierdac/orchestati.git"
  },
  "homepage": "https://github.com/javierdac/orchestati#readme",
  "bugs": {
    "url": "https://github.com/javierdac/orchestati/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "orchestration",
    "routing",
    "agent-router",
    "ai-sdk",
    "typescript",
    "cost-optimization",
    "multi-agent"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/dev",
    "README.md",
    "README.es.md",
    "MANUAL.md",
    "INTEGRATION.md",
    "LICENSE"
  ],
  "bin": {
    "orchestati": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json && cp -r src/ui dist/ui",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "table": "tsx src/dev/routing-table.ts",
    "eval": "tsx src/dev/eval.ts",
    "serve": "tsx src/server.ts",
    "smoke": "tsx src/dev/smoke.ts",
    "chat": "tsx src/dev/chat.ts",
    "eval:routing": "tsx src/dev/eval-routing.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "verify:package": "bash scripts/verify-package.sh",
    "eval:quality": "tsx src/dev/eval-quality.ts",
    "models": "tsx src/dev/models.ts",
    "tune": "tsx src/dev/tune.ts",
    "info": "tsx src/dev/info.ts",
    "cycle": "tsx src/dev/cycle.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@ai-sdk/provider": "4.0.14",
    "@types/json-schema": "^7.0.15",
    "ai": "^7.0.101",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
